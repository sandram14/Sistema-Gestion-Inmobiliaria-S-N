# =====================================================================
# Variables de entorno para Docker Compose
# =====================================================================
# 1. Copiar este archivo como docker/.env
# 2. Cambiar las contraseñas
# docker/.env NO se sube a Git (está en .gitignore).
# =====================================================================

# Sistema completo (Fase 16)
# Puerto del sitio en la PC: http://localhost (80). Si está ocupado, por ejemplo 8088.
WEB_PORT=80
# produccion: cookies Secure y errores sin detalles internos. Usar "desarrollo" solo para depurar.
APP_ENV=produccion
LOG_LEVEL=INFO

# Base de datos
DB_NAME=sn_inmobiliaria
DB_USER=sn_app
DB_PASSWORD=cambiar_esta_clave
DB_PORT=5433

# Administrador inicial (solo se crea la primera vez que se inicializa la base)
ADMIN_EMAIL=admin@sn-inmobiliaria.local
ADMIN_PASSWORD=cambiar_esta_clave_admin

# Asistente de IA (Gemini, nivel gratuito). La clave se obtiene en Google AI Studio.
# Nunca la escriba en el código ni la suba a Git: solo en docker/.env.
GEMINI_API_KEY=
# gemini-2.5-flash ya no está disponible para claves nuevas (verificado en octubre de 2026)
GEMINI_MODEL=gemini-3.1-flash-lite
# Razonamiento interno de los modelos Gemini 3: "minimal" no consume cuota extra ("ninguno" = no enviar)
GEMINI_THINKING_LEVEL=minimal
# Límites de uso (valores por defecto pensados para no agotar la cuota gratuita)
ASISTENTE_LIMITE_MINUTO_SESION=10
ASISTENTE_LIMITE_DIA_SESION=30
ASISTENTE_LIMITE_MINUTO_GLOBAL=8
ASISTENTE_LIMITE_DIA_GLOBAL=200
