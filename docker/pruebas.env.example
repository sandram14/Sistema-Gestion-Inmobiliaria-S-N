# =====================================================================
# Variables del entorno de PRUEBAS (docker-compose.pruebas.yml)
# =====================================================================
# 1. Copiar este archivo como docker/.env.pruebas (NO se sube a Git: está en .gitignore)
# 2. Cambiar las contraseñas. Son solo para la base de prueba, que vive en memoria:
#    no usar las del sistema real.
# =====================================================================

PRUEBA_DB_PASSWORD=cambiar-clave-de-prueba
# Administrador de la base de prueba (los recorridos de punta a punta inician sesión con él)
PRUEBA_ADMIN_EMAIL=prueba@sn.test
# Mínimo 10 caracteres, con letras y números
PRUEBA_ADMIN_PASSWORD=cambiar-Clave123

# Puertos en la PC (los del sistema real son 80 y 5433)
PRUEBA_WEB_PORT=8081
PRUEBA_DB_PORT=5434
